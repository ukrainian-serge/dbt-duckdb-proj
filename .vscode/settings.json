{

    "python.testing.pytestArgs": [
        "tools"
    ],

    

    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",

    "python.analysis.autoImportCompletions": true,

    "files.exclude": {
        "**/.git": false
    },

    "files.associations": {
        "*.sql": "jinja-sql",
        // "*.yml": "jinja-yml",
        // "*.md": "jinja-md"
    },

    // "yaml.schemas": {
    //     "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/dbt_yml_files.json": "*.yml"
    // }

    "yaml.schemas": {
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/dbt_yml_files-latest.json": [
            "/**/*.yml",
            "!profiles.yml",
            "!dbt_project.yml",
            "!packages.yml",
            "!selectors.yml",
            "!profile_template.yml",
            "!package-lock.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/dbt_project-latest.json": [
            "dbt_project.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/selectors-latest.json": [
            "selectors.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/packages-latest.json": [
            "packages.yml"
        ]
    },
    "sqltools.connections": [
        {
            "name": "DEV",
            "authenticator": "CLI",
            "location": "us",
            "previewLimit": 100,
            "driver": "BigQuery",
            "projectId": "dbt-dev-503215"
        },
        {
            "name": "PROD",
            "authenticator": "CLI",
            "location": "us",
            "previewLimit": 100,
            "driver": "BigQuery",
            "projectId": "dbt-prod-503215"
        },
        {
            "name": "RAW",
            "authenticator": "CLI",
            "location": "us",
            "previewLimit": 100,
            "driver": "BigQuery",
            "projectId": "raw-data-503215"
        },
        {
            "name": "DuckDB",
            "accessMode": "Read/Write",
            "duckdbOptions": {
                "enable_external_access": true,
                "autoinstall_known_extensions": true,
                "autoload_known_extensions": true,
                "allow_community_extensions": true
            },
            "previewLimit": 50,
            "driver": "DuckDB",
            "database": "${workspaceFolder:dbt-duckdb-proj}/warehouse.duckdb"
        }
    ],
    // "dbt.dbtMajorVersion": "v1",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.parquet": "duckdb.dataFileViewer",
        "*.csv": "duckdb.dataFileViewer",
        "*.tsv": "duckdb.dataFileViewer",
        "*.xlsx": "duckdb.dataFileViewer"
    }


}