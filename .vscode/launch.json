{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/gen_load.py",
            "args": [
                "--date-from", "2026-08-01",
                "--date-to", "2026-08-05",
                "--write-mode", "replace"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}